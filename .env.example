# Copy to .env before running `pnpm dev`.
# The root dev script loads this file for both apps.

# Server HTTP
PORT=3001

# Server persistence (relative to apps/server when using `pnpm dev`)
SQLITE_FILENAME=./.data/app.db

# Auth/JWT
AUTH_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
AUTH_JWT_ISSUER=effect-template
AUTH_JWT_AUDIENCE=effect-template-web
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600

# Webapp
VITE_API_URL=http://localhost:3001

# Observability: use "off" for the default no-tracing quickstart.
# Start the collector with `pnpm observability:up` and set both endpoints to
# http://localhost:4318 to export local traces.
OTEL_EXPORTER_OTLP_ENDPOINT=off
OTEL_SERVICE_NAME=todo-server
OTEL_SERVICE_VERSION=0.1.0
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=off
VITE_OTEL_SERVICE_NAME=todo-webapp
VITE_OTEL_SERVICE_VERSION=0.1.0
