{
  "name": "effect-monorepo-template",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "dotenv -e .env -- concurrently --kill-others --kill-timeout 5000 --names server,webapp --prefix-colors blue,green \"cd apps/server && ./node_modules/.bin/tsx watch src/main.ts\" \"cd apps/webapp && ./node_modules/.bin/vite\"",
    "observability:up": "docker compose up -d jaeger otel-collector",
    "observability:down": "docker compose down",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "boundaries": "depcruise --config .dependency-cruiser.cjs apps packages",
    "verify:architecture": "pnpm boundaries && node scripts/check-webapp-architecture.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/node": "^25.2.0",
    "concurrently": "^9.2.1",
    "dependency-cruiser": "^17.3.10",
    "dotenv-cli": "^11.0.0",
    "typescript": "^5.9.3"
  }
}
