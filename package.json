{
  "name": "effect-monorepo-template",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @app/server --filter @app/webapp dev",
    "cli": "pnpm --filter @app/cli dev --",
    "observability:up": "docker compose up -d jaeger otel-collector",
    "observability:down": "docker compose down",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/node": "^25.2.0",
    "typescript": "^5.9.3"
  }
}
