{
  "name": "@app/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.dev.ts",
    "prod": "tsx src/main.prod.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json",
    "test": "vitest run",
    "smoke:server": "vitest run src/test/smoke",
    "db:migrate": "tsx src/database/cli.ts migrate --adapter sqlite",
    "db:seed": "tsx src/database/cli.ts seed --adapter sqlite",
    "db:reset": "tsx src/database/cli.ts reset --adapter sqlite",
    "db:migrate:postgres": "tsx src/database/cli.ts migrate --adapter postgres",
    "db:seed:postgres": "tsx src/database/cli.ts seed --adapter postgres"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "@effect/opentelemetry": "4.0.0-beta.58",
    "@effect/platform-node": "4.0.0-beta.58",
    "@effect/sql-pg": "4.0.0-beta.58",
    "@effect/sql-sqlite-node": "4.0.0-beta.58",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.5.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.211.0",
    "@opentelemetry/sdk-trace-base": "^2.5.0",
    "@opentelemetry/sdk-trace-node": "^2.5.0",
    "effect": "4.0.0-beta.58",
    "jose": "^6.2.2"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.58",
    "tsx": "^4.20.5",
    "vitest": "^4.1.5"
  }
}
